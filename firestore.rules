rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- helpers ---------- */
    function isSignedIn() {
      return request.auth != null;
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isActive() {
      return isSignedIn() && myProfile().data.status == 'ativo';
    }
    function isGestor() {
      return isActive() && myProfile().data.role == 'gestor';
    }
    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    /* ---------- usuarios ----------
       As contas de login (e-mail/senha) sao criadas manualmente no Firebase
       Auth pelo administrador. O documento do perfil (users/{uid}) e criado
       automaticamente pelo app no primeiro acesso, sempre como executor(a)
       ativo(a) -- nunca com papel de gestor. Para promover a primeira pessoa
       a gestor(a), edite o campo "role" desse documento no Firestore Console. */
    match /users/{userId} {
      allow read: if isActive();
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'executor'
        && request.resource.data.status == 'ativo';
      allow update: if isGestor()
        || (isSignedIn() && request.auth.uid == userId && changedOnly(['lastLogin']));
      allow delete: if false;
    }

    /* ---------- demandas ----------
       Gestor: cria, edita, aprova, exclui e reatribui livremente.
       Executor: pode assumir uma demanda em "demandas" (vira responsavel),
       enviar sua propria demanda de "producao" para "aprovacao", e sempre
       pode comentar / anexar arquivos. */
    match /jobs/{jobId} {
      allow read: if isActive();
      allow create: if isGestor();
      allow delete: if isGestor();
      allow update: if isGestor()
        || (isActive() && (
             (resource.data.status == 'demandas'
                && request.resource.data.status == 'producao'
                && request.resource.data.assignedTo == request.auth.uid
                && changedOnly(['status','assignedTo','updatedAt']))
          || (resource.data.status == 'producao'
                && request.resource.data.status == 'aprovacao'
                && resource.data.assignedTo == request.auth.uid
                && changedOnly(['status','updatedAt']))
          || changedOnly(['comments','updatedAt'])
          || changedOnly(['attachments','updatedAt'])
           ));
    }

    /* ---------- clientes ----------
       Gestor: edita dados de clientes existentes e exclui.
       Executor: pode cadastrar novos clientes e registrar
       contatos/acompanhamentos (so mexe no historico, ultimo contato e
       proximo acompanhamento de um cliente ja existente). */
    match /clients/{clientId} {
      allow read: if isActive();
      allow create: if isActive();
      allow delete: if isGestor();
      allow update: if isGestor()
        || (isActive() && changedOnly(['timeline','lastContact','nextFollowUp','updatedAt']));
    }

    /* ---------- log de atividades ----------
       Qualquer pessoa ativa pode gravar (a propria acao gera o registro).
       So o gestor consulta o historico completo. Imutavel. */
    match /logs/{logId} {
      allow read: if isGestor();
      allow create: if isActive() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    /* ---------- contador de codigo das demandas (JOB-0001, JOB-0002...) --- */
    match /meta/counters {
      allow read, write: if isGestor();
    }

    /* ---------- NPS de eventos ----------
       Qualquer pessoa ativa (gestor ou executor) cria e le eventos e
       resultados. So o gestor edita eventos de outra pessoa, exclui e
       encerra manualmente (a propria tela ja esconde "Encerrar agora"
       para quem nao e gestor).
       Publico (sem login): consegue abrir UM evento pelo id (para o
       formulario /nps/?event=ID funcionar e mostrar "encerrado" quando for
       o caso), mas nao pode listar todos os eventos. Enquanto o evento
       estiver ativo e antes do horario limite, qualquer visitante pode
       enviar UMA avaliacao (so os campos score/createdAt, com createdAt
       obrigatoriamente igual ao horario do servidor) e incrementar em 1 o
       contador "responseCount" do evento -- nada mais. Nenhuma outra
       leitura ou escrita publica e permitida. */
    match /npsEvents/{eventId} {
      allow get: if true;
      allow list: if isActive();
      allow create: if isActive()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'ativo';
      allow delete: if isGestor();
      allow update: if isGestor()
        || (
             changedOnly(['responseCount']) &&
             resource.data.status == 'ativo' &&
             resource.data.closesAt is timestamp &&
             request.time < resource.data.closesAt &&
             request.resource.data.responseCount == resource.data.responseCount + 1
           );

      match /responses/{responseId} {
        allow create: if
          get(/databases/$(database)/documents/npsEvents/$(eventId)).data.status == 'ativo' &&
          get(/databases/$(database)/documents/npsEvents/$(eventId)).data.closesAt is timestamp &&
          request.time < get(/databases/$(database)/documents/npsEvents/$(eventId)).data.closesAt &&
          request.resource.data.keys().hasOnly(['score','createdAt']) &&
          request.resource.data.score is int &&
          request.resource.data.score >= 1 && request.resource.data.score <= 10 &&
          request.resource.data.createdAt == request.time;
        allow read: if isActive();
        allow update, delete: if false;
      }
    }
  }
}
